# Copy to .env and replace every value before starting.
DOMAIN=images.example.com
LIBRARY_DOMAIN=library.example.com
IMAGE_STUDIO_URL=https://images.example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-unique-password-at-least-14-chars
SESSION_SECRET=replace-with-at-least-32-random-characters
MAX_UPLOAD_MB=15
MAX_REFERENCE_TOTAL_MB=60
# Change this PyTorch image to match your GPU architecture if needed.
PYTORCH_BASE=pytorch/pytorch:2.7.1-cuda12.8-cudnn9-runtime

# Image-library database and shared site password. Use a quoted hash value from:
# docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-shared-password'
POSTGRES_DB=image_library
POSTGRES_USER=image_library
POSTGRES_PASSWORD='replace-with-a-long-random-database-password'
LIBRARY_AUTH_USER=friends
LIBRARY_AUTH_HASH='$2a$14$paste_the_hash_from_caddy_here'
MEDIA_PROXY_SECRET=replace-with-another-32-byte-random-secret
MEDIA_MAX_UPLOAD_MB=20

# Optional Discord bot. Set these before running `docker compose --profile discord up -d`.
DISCORD_TOKEN=your-discord-application-bot-token
DISCORD_BOT_SECRET=replace-with-a-second-long-random-secret
